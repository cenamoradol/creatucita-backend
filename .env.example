# Database Configuration
# Local dev: usa los campos individuales
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=password123
DB_NAME=creatucita
# Producción (Render/Railway/etc): descomenta y pega la URL completa
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Authentication
JWT_SECRET=super-secret-key-change-this-in-production
JWT_EXPIRES_IN=1d

# App Configuration
PORT=3002
NODE_ENV=development

# Mail Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM=noreply@creatucita.com

# Cloudflare R2 (almacenamiento de archivos: DNI, fotos de perfil)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=creatucita-uploads
# Opcional: dominio custom para URLs públicas (ej: https://cdn.tudominio.com)
# Si vacío, usa la URL pública de R2: https://pub-<account>.r2.dev
R2_PUBLIC_BASE_URL=
